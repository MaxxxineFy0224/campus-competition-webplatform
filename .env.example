# ========================================
# 校园竞赛组队平台 —— 环境变量配置
#
# 使用方式:
#   1. 复制此文件为 .env
#   2. 修改 .env 中的密码和密钥
#   3. 不要将 .env 提交到 Git！
# ========================================

# MySQL 数据库密码（务必修改为强密码）
MYSQL_ROOT_PASSWORD=your_strong_password_here

# JWT 签名密钥（务必修改为随机字符串）
JWT_SECRET=your_random_secret_key_at_least_32_chars

# AI API Key（硅基流动 / OpenAI 兼容的 API Key）
OPENAI_API_KEY=sk-your_api_key_here

# ========================================
# 可选配置
# ========================================

# MySQL 端口（默认 3306）
# MYSQL_PORT=3306

# 后端端口（默认 8080）
# BACKEND_PORT=8080

# 前端端口（默认 80）
# FRONTEND_PORT=80

# 跨域允许的来源（生产环境填写实际域名，多个用逗号分隔）
# CORS_ALLOWED_ORIGINS=http://your-domain.com